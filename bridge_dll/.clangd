# 补齐 CMake/MSVC 构建里的头文件搜索路径，避免 IDE 语言服务器按裸编译解析。
CompileFlags:
  Add:
    - -Iinclude
    - -Isrc
    - -Ibuild
    - -Ivcpkg_installed/x64-windows/include
    - -std=c++20
    - -DUNICODE
    - -D_UNICODE
    - -DNOMINMAX
    - -DWIN32_LEAN_AND_MEAN
    - -fms-extensions
    - -fms-compatibility
    - -fdelayed-template-parsing
