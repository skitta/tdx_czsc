{ ================================================================ }
{ 买卖点类型标注 (buy_sell_mark.tn6)                                }
{                                                                   }
{ 技术指标公式(主图叠加): 在 401~406 买卖点处标注类型文字与图标.     }
{ 背景: 通达信"专家系统(交易系统)"公式(buy_sell_expert.tn6)不允许   }
{ 使用绘图函数, B/S 箭头由系统自动绘制但无法区分买卖点类型; 本脚本  }
{ 承担类型标注, 可与专家系统指示同时叠加使用.                       }
{                                                                   }
{ 导入: 公式管理器 -> 新建 -> 公式类型选"技术指标" -> 主图叠加.      }
{ 依赖: 本仓库 bridge DLL 已绑定编号 1(否则把 TDXDLL1 改为对应编号); }
{       401~406 买卖点通道由 Rust 服务计算(需 DLL + 服务运行).      }
{ ================================================================ }

{ ==== 显示开关 ==== }
图标开关:=1;     { 1=画买卖点图标 0=不画 }
文字开关:=1;     { 1=画'一买'/'一卖'等类型文字 0=不画 }

{ ==== 通道读取 (与 main_chart_full.tn6 同一套约定) ==== }
{ 周期输入 951: 必须在首个分析通道前调用, 让 DLL 记录当前图表周期 }
周期输入:=TDXDLL1(951,HIGH,LOW,PERIOD+0*CLOSE);
{ 量能通道 950: 把 VOL 传给 DLL 融合进分析, 恢复一买/一卖的真实量能背驰维度;
  必须出现在 401~406 调用之前(通达信按公式文本顺序求值) }
量能:=TDXDLL1(950,HIGH,LOW,VOL);
一买:=TDXDLL1(401,HIGH,LOW,CLOSE);
一卖:=TDXDLL1(402,HIGH,LOW,CLOSE);
二买:=TDXDLL1(403,HIGH,LOW,CLOSE);
二卖:=TDXDLL1(404,HIGH,LOW,CLOSE);
三买:=TDXDLL1(405,HIGH,LOW,CLOSE);
三卖:=TDXDLL1(406,HIGH,LOW,CLOSE);

{ ==== 间距单位: 平均K线振幅(周期自适应) ==== }
振幅:=MA(HIGH-LOW,10);
图标距:=振幅*0.3;   { 图标中心到K线边缘: 紧贴 }
文字距:=振幅*1.0;   { 文字在图标外侧 }

{ ==== 图标: 买点在K线下缘、卖点在K线上缘 ==== }
DRAWICON(一买>0 AND 图标开关=1,一买-图标距,1);
DRAWICON(一卖>0 AND 图标开关=1,一卖+图标距,2);
DRAWICON(二买>0 AND 图标开关=1,二买-图标距,1);
DRAWICON(二卖>0 AND 图标开关=1,二卖+图标距,2);
DRAWICON(三买>0 AND 图标开关=1,三买-图标距,1);
DRAWICON(三卖>0 AND 图标开关=1,三卖+图标距,2);

{ ==== 类型文字: 买点在下方、卖点在上方 ==== }
DRAWTEXT(一买>0 AND 文字开关=1,一买-文字距,'一买'),COLORRED;
DRAWTEXT(一卖>0 AND 文字开关=1,一卖+文字距,'一卖'),COLORGREEN;
DRAWTEXT(二买>0 AND 文字开关=1,二买-文字距,'二买'),COLORFF00FF;
DRAWTEXT(二卖>0 AND 文字开关=1,二卖+文字距,'二卖'),COLOR00AA00;
DRAWTEXT(三买>0 AND 文字开关=1,三买-文字距,'三买'),COLORYELLOW;
DRAWTEXT(三卖>0 AND 文字开关=1,三卖+文字距,'三卖'),COLOR00FFFF;
