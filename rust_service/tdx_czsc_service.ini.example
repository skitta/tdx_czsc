# 缠论分析服务端配置（可选，文件不存在时全部使用内置默认值）。
# 与本文件同目录的 tdx_czsc_service.exe 启动时读取；键名 = 值，UTF-8 编码，
# # 或 ; 开头为注释。环境变量 TDX_CZSC_* 优先级高于本文件。
#
# 注意：与 Bridge DLL 的 tdx_czsc_bridge.ini 一样放在通达信 T0002/dlls/
# 目录（服务端 exe 也在那里）；DLL 请求携带的 max_bi_num/min_bi_len/
# analysis_window 会覆盖这里的同名默认值（公式即发即生效）。

# 命名管道名（默认 \\.\pipe\tdx_czsc_analyzer，一般无需修改）
# pipe_name = \\.\pipe\tdx_czsc_analyzer

# 笔参数默认值（DLL 每请求都会下发，这里仅作为请求缺省时的兜底）
# max_bi_num = 1000
# min_bi_len = 6

# 分析窗口：0 = 全量（默认，配合增量缓存稳态维护）；正数 = 尾部 N 根
# analysis_window = 0

# 快照缓存条数（全量分析结果 LRU）
# cache_capacity = 64

# 增量分析开关（默认开；关闭后每次请求全量分析）
# enable_incremental = true

# 增量状态缓存条数（每条目持有演化中的 CZSC 与完整窗口 K 线，内存敏感）
# incremental_cache_capacity = 8

# 全量分析并发上限（多窗口/多公式同时首刷时共享）
# analysis_parallelism = 4

# 通达信公式未挂 950 量能通道时，以单根振幅代理量恢复量能背驰判定
# derive_volume_proxy = true