{ ================================================================ }
{ 买点 ATR 日线止损线 (ATR_SL_DAY.TN6)                               }
{                                                                   }
{ 主图叠加模板: 一买(401)/二买(403)/三买(405)各自独立成段, 每个买点  }
{ 从自己的锚点K线起画 ATR 动态止损线; K线下穿止损线即终止该段绘画.   }
{                                                                   }
{ 本模板只在日线周期显示(PERIOD=5), 分钟/周/月等周期输出 DRAWNULL.   }
{ 注意: PERIOD 的日线编码因通达信版本而异, 不一致时先输出 PERIOD     }
{       验证再改本文件的日线门控.                                    }
{                                                                   }
{ 本模板只画止损线, 不含止盈线、缠论结构线、文字或图标.              }
{ 依赖: 本仓库 BRIDGE DLL 已绑定编号 1(否则把 TDXDLL1 改为对应编号); }
{       401/403/405 买点通道由 RUST 服务计算(需 DLL + 服务运行).     }
{ ================================================================ }

{ ==== 参数 (改数字即可) ==== }
{ 951 通道把当前图表周期传给 DLL; 本模板仍用 PERIOD=5 限定只画日线. }
周期输入:=TDXDLL1(951,HIGH,LOW,PERIOD+0*CLOSE);
ATR周期:=14;
止损倍数:=2.0;
触发方式:=1;   { 1=影线破位(低价穿线) 2=收盘破位 }

{ ==== 通道读取 ==== }
一买:=TDXDLL1(401,HIGH,LOW,CLOSE);
二买:=TDXDLL1(403,HIGH,LOW,CLOSE);
三买:=TDXDLL1(405,HIGH,LOW,CLOSE);

{ ==== ATR (手写 TR, 跨版本兼容) ==== }
TR1:=MAX(MAX(HIGH-LOW,ABS(HIGH-REF(CLOSE,1))),ABS(LOW-REF(CLOSE,1)));
波幅:=MA(TR1,ATR周期);

{ ==== 一买段 ==== }
一有:=COUNT(一买>0,0)>0;
一距:=BARSLAST(一买>0);
一区:=一距+1;
一损:=HHV(HIGH-止损倍数*波幅,一区);
一破:=IF(触发方式=2,CLOSE,LOW)<一损 AND 一距>0;
一触:=COUNT(一破,一区)>0;

{ ==== 二买段 ==== }
二有:=COUNT(二买>0,0)>0;
二距:=BARSLAST(二买>0);
二区:=二距+1;
二损:=HHV(HIGH-止损倍数*波幅,二区);
二破:=IF(触发方式=2,CLOSE,LOW)<二损 AND 二距>0;
二触:=COUNT(二破,二区)>0;

{ ==== 三买段 ==== }
三有:=COUNT(三买>0,0)>0;
三距:=BARSLAST(三买>0);
三区:=三距+1;
三损:=HHV(HIGH-止损倍数*波幅,三区);
三破:=IF(触发方式=2,CLOSE,LOW)<三损 AND 三距>0;
三触:=COUNT(三破,三区)>0;

{ ==== 输出: 三条日线止损线 (仅未触发段显示) ==== }
一买止损:IF(PERIOD=5 AND 一有 AND NOT(一触),一损,DRAWNULL),COLORGREEN,LINETHICK1;
二买止损:IF(PERIOD=5 AND 二有 AND NOT(二触),二损,DRAWNULL),COLORGREEN,LINETHICK1;
三买止损:IF(PERIOD=5 AND 三有 AND NOT(三触),三损,DRAWNULL),COLORGREEN,LINETHICK1;
